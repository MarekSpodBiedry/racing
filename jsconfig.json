{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "checkJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "*.js",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
